# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database
DATABASE_URL=postgresql://finbrain:finbrain@localhost:5432/finbrain

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
FRONTEND_URL=http://localhost:5173

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Google Cloud
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

# Sentry
SENTRY_DSN=

# Encrypts third-party credentials at rest (Plaid access tokens).
# Required in production — the API refuses to store a token without it.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=

# Database backups (docker-compose.prod.yml). See docs/OPERATIONS.md.
# BACKUP_DIR is a host path: a backup that lives only inside Docker dies with
# the Docker host. Copy it off the machine.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
BACKUP_DIR=./backups
