# ─── Clerk Authentication ─────────────────────────────────────────
# 1. Sign up at https://clerk.com
# 2. Create a new application
# 3. Copy the "Publishable Key" → VITE_CLERK_PUBLISHABLE_KEY
# 4. Copy the "Secret Key" → CLERK_SECRET_KEY
# 5. In Clerk Dashboard → JWT Templates → create a custom template
#    or use the default "Clerk" template that includes sub, email, name
# 6. (Optional) In Clerk Dashboard → Webhooks → add an endpoint pointing
#    to https://your-api.com/api/v1/webhooks/clerk for user sync
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Dev Mode ──────────────────────────────────────────────────────
# Set VITE_DEV_MODE=true to bypass Clerk auth during local development.
# The app will use a hardcoded dev user (dev-user-001).
# Set to false or remove when Clerk keys are configured.
VITE_DEV_MODE=true

# ─── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://finbrain:finbrain@localhost:5433/finbrain

# ─── API ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PORT=4000

# ─── Redis (optional) ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Plaid ─────────────────────────────────────────────────────────
# Get sandbox keys from https://dashboard.plaid.com/developers
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
