generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  USD
  EUR
  GBP
  INR
  JPY
  CAD
  AUD
}

enum TransactionType {
  income
  expense
}

enum PaymentMethod {
  cash
  credit_card
  debit_card
  bank_transfer
  upi
  other
}

enum TransactionStatus {
  pending
  cleared
  flagged
}

enum AccountType {
  checking
  savings
  credit
  loan
  investment
  real_estate
  other
}

enum BudgetPeriod {
  weekly
  monthly
  yearly
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  avatarUrl String?

  currency       Currency @default(USD)
  monthlyIncome  Float?
  onboardingCompleted Boolean @default(false)
  username   String?
  birthDate  DateTime?
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions        Transaction[]
  accounts            Account[]
  categorizationRules CategorizationRule[]
  categories          Category[]
  budgets             Budget[]
  goals               Goal[]
  forecasts           Forecast[]
  recommendations     Recommendation[]
  financialHealth     FinancialHealth?
  receipts            Receipt[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  portfolios          Portfolio[]

  advisorProfile      AdvisorProfile?
  spendingPatterns    SpendingPattern[]
  advisorMemories     AdvisorMemory[]
  advisorConversations AdvisorConversation[]
  advisorInsights     AdvisorInsight[]
  scenarios           Scenario[]
  budgetPlans         BudgetPlan[]
  recurringPatterns   RecurringPattern[]

  @@map("users")
}

model Category {
  id     String @id @default(cuid())
  name   String
  icon   String @default("folder")
  color  String @default("#6b7280")
  parentId String?
  isCustom Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")
  transactions       Transaction[]
  categorizationRules CategorizationRule[]
  budgets            Budget[]
  goals              Goal[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@map("categories")
}

model Account {
  id        String      @id @default(cuid())
  name      String
  type      AccountType
  balance   Float       @default(0)
  currency  Currency    @default(USD)
  institution String?
  isActive  Boolean     @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amount      Float
  currency    Currency        @default(USD)
  description String
  merchant    String?
  categoryId  String
  paymentMethod PaymentMethod @default(other)
  date        DateTime
  notes       String?
  receiptUrl  String?
  status      TransactionStatus @default(cleared)
  isRecurring Boolean         @default(false)
  deletedAt   DateTime?

  reviewed    Boolean         @default(false)
  needsReview Boolean         @default(false)
  originalName String?
  pending     Boolean         @default(false)
  externalId  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category  Category @relation(fields: [categoryId], references: [id])
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, deletedAt])
  @@index([externalId])
  @@index([userId, needsReview])
  @@map("transactions")
}

model Budget {
  id        String       @id @default(cuid())
  amount    Float
  currency  Currency     @default(USD)
  period    BudgetPeriod @default(monthly)
  startDate DateTime
  endDate   DateTime?
  spent     Float        @default(0)
  remaining Float?

  budgetMode        String   @default("category")
  bucketType        String?
  rolloverEnabled   Boolean  @default(false)
  rolloverAmount    Float    @default(0)
  autoSuggested     Boolean  @default(false)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  histories BudgetHistory[]

  @@unique([userId, categoryId, period, startDate])
  @@map("budgets")
}

model BudgetHistory {
  id        String   @id @default(cuid())
  amount    Float
  spent     Float
  remaining Float
  recordedAt DateTime @default(now())

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@map("budget_histories")
}

model Goal {
  id            String  @id @default(cuid())
  name          String
  targetAmount  Float
  currency      Currency @default(USD)
  currentAmount Float    @default(0)
  deadline      DateTime?
  goalType      String   @default("custom")
  icon          String   @default("target")
  estimatedCompletion DateTime?

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contributions GoalContribution[]

  @@map("goals")
}

model GoalContribution {
  id       String   @id @default(cuid())
  amount   Float
  date     DateTime @default(now())
  notes    String?

  goalId String
  goal   Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("goal_contributions")
}

model Forecast {
  id      String   @id @default(cuid())
  type    String
  model   String
  period  String
  values  Json
  accuracy Float?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("forecasts")
}

model Recommendation {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String
  severity    String   @default("medium")
  category    String?
  amount      Float?
  read        Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("recommendations")
}

model FinancialHealth {
  id                  String   @id @default(cuid())
  score               Int      @default(0)
  savingsRate         Float    @default(0)
  expenseRatio        Float    @default(0)
  budgetAdherence     Float    @default(0)
  emergencyFundMonths Float    @default(0)
  debtRatio           Float    @default(0)
  spendingConsistency Float    @default(0)
  history             Json     @default("[]")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@map("financial_health")
}

model Receipt {
  id           String   @id @default(cuid())
  imageUrl     String
  merchant     String?
  amount       Float?
  date         DateTime?
  categoryId   String?
  status       String   @default("pending")
  notes        String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("receipts")
}

model Notification {
  id      String   @id @default(cuid())
  title   String
  message String
  type    String   @default("info")
  read    Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model CategorizationRule {
  id                 String   @id @default(cuid())
  priority           Int      @default(0)
  merchantPattern    String?
  descriptionPattern String?
  isActive           Boolean  @default(true)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, priority])
  @@map("categorization_rules")
}

model Portfolio {
  id          String  @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  holdings Holding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("portfolios")
}

model Holding {
  id              String   @id @default(cuid())
  symbol          String
  name            String
  quantity        Float
  avgCostBasis    Float
  currentPrice    Float?
  currency        Currency @default(USD)
  assetType       String   @default("stock")
  lastPriceUpdate DateTime?

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portfolioId])
  @@map("holdings")
}

model AdvisorProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dataStartDate         DateTime?
  dataEndDate           DateTime?
  transactionCount      Int      @default(0)
  dataQualityScore      Int      @default(0)
  confidence            String   @default("low")

  monthlyIncomeAvg      Float    @default(0)
  monthlyExpenseAvg     Float    @default(0)
  savingsRateAvg        Float    @default(0)
  emergencyFundMonths   Float    @default(0)
  debtToIncomeRatio     Float    @default(0)
  fixedExpenseRatio     Float    @default(0)
  variableExpenseRatio  Float    @default(0)

  incomeCadence         String?
  riskLevel             String   @default("unknown")
  advisorSummary        String?
  profileJson           Json     @default("{}")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("advisor_profiles")
}

model SpendingPattern {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId      String?
  merchant        String?
  patternType     String
  cadence         String?
  avgAmount       Float
  minAmount       Float?
  maxAmount       Float?
  monthAvg        Float?
  volatility      Float?
  confidence      Float    @default(0)
  sampleSize      Int      @default(0)
  lastSeenAt      DateTime?
  metadata        Json     @default("{}")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, patternType])
  @@index([userId, categoryId])
  @@map("spending_patterns")
}

model AdvisorMemory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  memoryType    String
  title         String
  content       String
  source        String
  confidence    Float    @default(0)
  importance    Int      @default(1)
  validFrom     DateTime @default(now())
  validUntil    DateTime?
  metadata      Json     @default("{}")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, memoryType])
  @@map("advisor_memories")
}

model AdvisorConversation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String?
  mode        String   @default("advisor")
  metadata    Json     @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    AdvisorMessage[]

  @@map("advisor_conversations")
}

model AdvisorMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    AdvisorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role            String
  content         String
  structuredData  Json?
  feedback        String?
  confidence      Float?

  createdAt       DateTime @default(now())

  @@map("advisor_messages")
}

model AdvisorInsight {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          String
  title         String
  summary       String
  severity      String   @default("info")
  priority      Int      @default(0)
  status        String   @default("active")
  evidence      Json     @default("[]")
  actions       Json     @default("[]")
  expiresAt     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status, priority])
  @@map("advisor_insights")
}

model Scenario {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  scenarioType    String
  input           Json
  result          Json
  recommendation  String
  confidence      Float
  createdAt       DateTime @default(now())

  @@map("scenarios")
}

model BudgetPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        String   @default("category")
  month       DateTime
  incomePlan  Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("budget_plans")
}

model RecurringPattern {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant        String
  categoryId      String?
  amountAvg       Float
  amountLast      Float?
  cadence         String
  nextExpectedAt  DateTime?
  lastSeenAt      DateTime?
  status          String   @default("active")
  confidence      Float    @default(0)
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("recurring_patterns")
}
